# Optional settings for Privilege Map LAB. The shared file ~/Development/.env (or the path in STANDALONE_ENV)
# is read for these keys only. No real values here. This app needs no tenant and no credentials.
# MODE=mock                 # mock is the default; this app has no live mode
# WORKSPACE_ID=default      # lowercase letters, digits and dashes; scopes the saved run state
# CUSTOMER_CONFIG=./customer.config.json   # branding and cast vocabulary (see customer.config.example.json)
