  "steps": [
    {
      "title": "Policy first, credential second",
      "what": "After sign-in and policy pass, the app's Auth Mode decides what the backend receives.",
      "why": "The caller's own gateway key is never forwarded.",
      "edges": [
        0
      ]
    },
    {
      "title": "Four modes",
      "what": "None sends no header; Static Token sends a configured bearer; User Token sends the user's vault credential; Pass Agent Token forwards a workload assertion.",
      "why": "Only Pass Agent Token is refused at the gateway: a remote agent set to it refuses key callers, so key callers need Static Token.",
