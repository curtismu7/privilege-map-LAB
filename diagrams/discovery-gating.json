        "tool"
      ],
      "x": 0,
      "y": 195
    },
    {
      "id": "logline",
      "group": "log",
      "label": "Gateway log records it",
      "sub": [
        "the removal and the reason",
        "live only here"
      ],
      "x": 640,
      "y": 195
    }
  ],
  "edges": [
    {
      "source": "list",
      "target": "filter",
      "label": "request passes the gateway"
    },
    {
      "source": "filter",
      "target": "seen",
      "label": "granted tools returned"
    },
    {
      "source": "filter",
      "target": "full",
      "label": "not forwarded whole"
    },
    {
      "source": "seen",
      "target": "call403",
      "label": "agent tries a hidden tool",
