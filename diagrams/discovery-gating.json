      "label": "removal and denials logged"
    }
  ],
  "steps": [
    {
      "title": "The list is filtered",
      "what": "Ungranted tools were removed from the response and the removal written to the gateway log.",
      "why": "Hiding the tool removes the knowledge, instead of only blocking calls.",
      "edges": [
        0,
        1,
        4
      ]
    },
    {
      "title": "Hidden means refused",
      "what": "A call for a hidden tool returns a plain HTTP 403 with no JSON-RPC body, the same as for a nonexistent tool.",
      "why": "The reason lives only in the gateway log; the only self-describing 403 names a missing mcp scope.",
      "edges": [
        3
      ]
    },
    {
      "title": "No policy denies from the first request",
      "what": "An app with no policy denies by default from the first request and returns a bare 403 before the backend is contacted.",
      "why": "Policy edits take about 4 minutes to reach the gateway, so a changed grant is not visible immediately.",
      "edges": [
        2
      ]
    }
  ]
