{
  "schema": "diagram-studio/1",
  "id": "discovery-gating",
  "title": "Ungranted tools are hidden",
  "lede": "The gateway filters tools/list to the set the caller's policy grants, so the agent never learns what it may not call.",
  "groups": {
    "agent": {
      "label": "Agent",
      "color": "blue"
    },
    "gw": {
      "label": "Gateway",
      "color": "dark"
    },
    "server": {
      "label": "MCP server",
      "color": "grey"
    },
    "log": {
      "label": "Evidence",
      "color": "green"
    }
  },
  "nodes": [
    {
      "id": "list",
      "group": "agent",
      "label": "tools/list request",
      "sub": [],
      "x": 0,
      "y": 0
    },
    {
      "id": "filter",
      "group": "gw",
      "label": "Filter to the grant",
      "sub": [
        "ungranted tools removed"
      ],
      "x": 320,
      "y": 0
    },
    {
      "id": "seen",
      "group": "agent",
      "label": "Agent sees granted tools only",
      "sub": [
        "ungranted ones cannot be",
        "tried later"
      ],
      "x": 640,
      "y": 0
    },
    {
      "id": "full",
      "group": "server",
      "label": "Full tool list",
      "sub": [
        "never shown unfiltered"
      ],
      "x": 320,
      "y": 130
    },
    {
      "id": "call403",
      "group": "gw",
      "label": "Call for a hidden tool",
      "sub": [
        "bare HTTP 403, no JSON-RPC",
